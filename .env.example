# =============================================================================
# Solana 24/7 Trading System — Environment Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit .env or wallet private keys to git.
# =============================================================================

# --- Runtime Mode ---
TRADING_MODE=paper
LOG_LEVEL=INFO

# --- Storage (DuckDB single-writer) ---
DUCKDB_PATH=data/trading.duckdb
PARQUET_BACKUP_DIR=backups/parquet

# --- Solana RPC & WebSocket (Helius, QuickNode, Triton, etc.) ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# --- Market Data & Quotes ---
JUPITER_API_URL=https://quote-api.jup.ag/v6
DEXSCREENER_API_URL=https://api.dexscreener.com
BIRDEYE_API_KEY=

# --- Telegram Alerts & Kill Switch Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM Analyst & Supervisor (optional, behind LLMClient interface) ---
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_DAILY_BUDGET_USD=1.00
LLM_INPUT_COST_PER_1M_USD=0.10
LLM_OUTPUT_COST_PER_1M_USD=0.40

# --- Paper Account ---
PAPER_INITIAL_CAPITAL_SOL=10.0
PAPER_EXTRA_SLIPPAGE_BPS=50
PAPER_PRIORITY_FEE_LAMPORTS=5000

# --- Deterministic Risk Management & Kill Switches ---
RISK_MAX_POSITION_PCT=0.02
RISK_MAX_OPEN_POSITIONS=5
RISK_MAX_TOTAL_EXPOSURE_PCT=0.30
RISK_STOP_LOSS_PCT=0.20
RISK_TAKE_PROFIT_PARTIAL_PCT=0.50
RISK_MAX_HOLD_HOURS=24
RISK_MIN_LIQUIDITY_USD=50000.0
RISK_MIN_TOKEN_AGE_MINUTES=60
RISK_MAX_PRICE_IMPACT_PCT=0.02
RISK_MAX_DAILY_LOSS_PCT=0.05
RISK_MAX_DRAWDOWN_PCT=0.20
RISK_STALE_DATA_SECONDS=60
